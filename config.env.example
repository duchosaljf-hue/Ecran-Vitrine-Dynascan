# Copiez ce fichier en « config.env » et adaptez-le. Les lignes commençant par # sont ignorées.

# --- Synchronisation du dossier Google Drive (voir README.md) ---
# Nom du « remote » rclone créé avec « rclone config » (le deux-points final est obligatoire).
RCLONE_REMOTE=vitrine:
# 1 = synchroniser depuis Drive, 0 = utiliser seulement le dossier local data/inbox (tests)
SYNC_ENABLED=1
# Fréquence de synchronisation, en secondes
SYNC_INTERVAL=300

# --- Diffusion ---
# Durée d'affichage d'une image ou d'une page de PDF, en secondes
IMAGE_SECONDS=10
# Afficher l'horloge et la météo (1) ou non (0)
WIDGETS=1

# --- Météo : Carquefou (44470) ---
CITY=Carquefou
LATITUDE=47.2978
LONGITUDE=-1.4903
TIMEZONE=Europe/Paris

# --- Surveillance ---
# Température (°C) à partir de laquelle le serveur écrit un avertissement dans le journal
TEMP_WARN_C=80

# --- Écran ---
# Rotation de l'image envoyée à l'écran : left, right, normal ou inverted.
# L'écran est monté en portrait, tourné de 90° dans le sens horaire (manuel DynaScan) :
# si l'image est couchée à l'installation, essayez l'autre valeur (left <-> right).
SCREEN_ROTATION=left
