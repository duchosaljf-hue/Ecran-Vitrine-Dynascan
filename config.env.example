# Copiez ce fichier en « config.env » et adaptez-le (le script d'installation le fait pour vous).
# Les lignes commençant par # sont ignorées. Après modification : sudo systemctl restart vitrine
#
# La plupart des réglages (écrans, durées, météo, alertes, comptes…) se font dans la page de gestion :
#     http://ADRESSE-DU-NUC:8080/admin/
# Ce fichier ne contient que ce qui concerne le NUC lui-même.

# --- Serveur ---
# 0.0.0.0 = joignable depuis tout le réseau de l'agence (autres écrans, téléphones, PC) ; 127.0.0.1 = le NUC seul
VITRINE_HOST=0.0.0.0
VITRINE_PORT=8080
# Taille maximale d'un fichier envoyé, en Mo
MAX_UPLOAD_MB=400

# --- Surveillance ---
# Température (°C) à partir de laquelle le NUC est signalé (journal, et e-mail si les alertes sont activées)
TEMP_WARN_C=80

# --- Écran branché en HDMI sur le NUC ---
# Rotation de l'image envoyée à l'écran : left, right, normal ou inverted.
# L'écran est monté en portrait, tourné de 90° dans le sens horaire (manuel DynaScan) :
# si l'image est couchée à l'installation, essayez l'autre valeur (left <-> right).
SCREEN_ROTATION=left
